"sum" {
    ("nil" . y) -> y;
    (("+1" . x) . y) -> "sum": (x . ("+1" . y));
}

"mul" {
    ("nil" . y) -> "nil";
    (("+1" . x) . y) -> "mul": (x . y) {
        x_times_y -> "sum": (x_times_y  . y);
    }
}

"main" {
    _ -> "mul": (
        ("+1" "+1")
        .
        ("+1" "+1" "+1")
    );
}
